# Auto detect text files and perform LF normalization
* text=auto

# Go files
*.go text eol=lf
go.mod text eol=lf
go.sum text eol=lf

# Web files
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.html text eol=lf

# Configuration files
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.xml text eol=lf
Dockerfile text eol=lf
Makefile text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# Documentation
*.md text eol=lf
LICENSE text eol=lf

# Scripts
*.sh text eol=lf

# Language statistics
# Mark generated files
internal/reporter/graphql/generated/* linguist-generated=true
web/build/* linguist-generated=true
vendor/* linguist-vendored=true

# The v2 SPA bundle is committed because //go:embed all:dist needs it
# on disk at Go-build time. Mark it generated so PR diffs collapse the
# minified JS/CSS and sourcemaps by default, language-stats ignore it,
# and `git log -p` treats it as opaque.
internal/web/dist/** linguist-generated=true
internal/web/dist/** binary

# Mark documentation
docs/* linguist-documentation=true
*.md linguist-documentation=true

# Ensure Go is the primary language
*.go linguist-language=Go