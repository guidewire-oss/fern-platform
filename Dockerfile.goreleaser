# Runtime stage for pre-built binaries from GoReleaser
FROM alpine:3.24

# Install runtime dependencies, then deselect the eMudhra (emSign) roots from
# the trust store (Alpine's Mozilla bundle still ships them). The final check
# fails the build if an emSign entry is still enabled or its cert is still in
# the bundle.
RUN apk add --no-cache ca-certificates tzdata && \
    sed -i 's#^mozilla/emSign#!mozilla/emSign#' /etc/ca-certificates.conf && \
    update-ca-certificates --fresh && \
    ! grep -q '^mozilla/emSign' /etc/ca-certificates.conf && \
    for f in /usr/share/ca-certificates/mozilla/emSign*.crt; do \
      [ -e "$f" ] || continue; \
      ! grep -v -- '-----' "$f" | grep -qxFf - /etc/ssl/certs/ca-certificates.crt || exit 1; \
    done

# Create non-root user
RUN addgroup -g 1000 -S fern && \
    adduser -u 1000 -S fern -G fern

# Create directories
RUN mkdir -p /app/web && \
    chown -R fern:fern /app

WORKDIR /app

# Copy the pre-built binary from GoReleaser build context
# The binary is at the root of the build context, not from repo paths
COPY fern-platform /app/

# Copy required directories from the repository
COPY config /app/config
COPY migrations /app/migrations
COPY web /app/web

# Set ownership
RUN chown -R fern:fern /app

USER fern

EXPOSE 8080

ENTRYPOINT ["/app/fern-platform"]